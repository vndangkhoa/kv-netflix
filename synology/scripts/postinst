#!/bin/sh
# postinst: runs after package files are extracted to SYNOPKG_PKGDEST

PKG_DIR="$SYNOPKG_PKGDEST"
ETC_DIR="$PKG_DIR/etc"
VAR_DIR="$PKG_DIR/var"

mkdir -p "$ETC_DIR" "$VAR_DIR"

WEB_PORT="8000"

# Parse wizard variables if available
if [ -n "$SYNOPKG_TEMP_LOGFILE" ] && [ -f "$SYNOPKG_TEMP_LOGFILE" ]; then
    PORT_VAL=$(grep "^wizard_port=" "$SYNOPKG_TEMP_LOGFILE" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
    if [ -n "$PORT_VAL" ]; then
        WEB_PORT="$PORT_VAL"
    fi
fi

ENV_FILE="$ETC_DIR/config.env"

# Preserve existing configuration if upgrading
if [ -f "$ENV_FILE" ]; then
    if [ "$WEB_PORT" = "8000" ]; then
        EXISTING_PORT=$(grep "^PORT=" "$ENV_FILE" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        if [ -n "$EXISTING_PORT" ]; then
            WEB_PORT="$EXISTING_PORT"
        fi
    fi
fi

# Write environment configuration
cat <<EOF > "$ENV_FILE"
PORT=${WEB_PORT}
DATABASE_URL=${VAR_DIR}/streamflow.db
TZ=Asia/Ho_Chi_Minh
GIN_MODE=release
ALLOWED_ORIGINS=*
EOF

chmod 600 "$ENV_FILE"

# Write port configuration for Synology DSM Firewall / Reverse Proxy
cat <<EOF > "$ETC_DIR/port.conf"
[kv-netflix]
title="Kv-Netflix"
desc="Kv-Netflix Streaming Platform"
port_forward="yes"
dst.ports="${WEB_PORT}/tcp"
EOF

# Ensure executable permissions on binaries
chmod +x "$PKG_DIR/server"
if [ -f "$PKG_DIR/scripts/yt-dlp" ]; then
    chmod +x "$PKG_DIR/scripts/yt-dlp"
fi

# Set ownership to package service account (DSM 7 uses sc-kvnetflix)
if id "sc-kvnetflix" >/dev/null 2>&1; then
    chown -R sc-kvnetflix:sc-kvnetflix "$VAR_DIR" "$ETC_DIR"
elif id "http" >/dev/null 2>&1; then
    chown -R http:http "$VAR_DIR" "$ETC_DIR"
fi

exit 0
